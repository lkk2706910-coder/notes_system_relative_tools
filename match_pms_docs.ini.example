; 複製成 match_pms_docs.ini 放在 exe / .py 同資料夾即生效；只需列出要覆蓋的項目。
[pms]
server       = UMCD20/UMC
dbfile       = eri\pms.nsf
docno_view   = (ByDocNo)
docno_field  = DOCNO
; Excel key 欄要對 ePMS 哪個欄位：DOCNO（單號）/ A21（material）/ A22（原廠料號）。視窗裡也可臨時切換
epms_key_field   = DOCNO
epms_key_options = DOCNO,A21,A22
; 要帶出的欄位（A21 / A22 / VendorNameList 不在這裡也會自動補上；用 A21/A22 搜尋時會再補 DOCNO）
fetch_fields = A17,A21,A22,A25,A26,VendorNameList
class_field  = A17
; 是否比對 ePMS（視窗裡可臨時勾選）
epms_enabled = true
; 用 A21/A22 搜尋時同一 key 可能對到多筆：all＝每筆各一列；first＝只取第一筆
multi_match  = all
; 備援欄位：DOCNO U 開頭的單資料在 A21/A22/A26，V 開頭的單同樣資料存在 C11/C12/C15。
; 主欄位空就改讀備援欄；用 A21/A22 搜尋時也一併搜備援欄。
; 格式 主欄:備援欄,...（備援多個用 / 分隔）。對應關係可用視窗「檢查欄位…」核對後調整
field_fallbacks = A21:C11,A22:C12,A26:C15

; 第二個資料庫（驗收系統 GR）：同一個 key 對 DCNUM，把文件連結放在 ePMS Link 右邊的 GR Link（視窗裡可臨時勾選）
gr_enabled   = true
gr_server    = UMCD14/UMC
gr_dbfile    = eop\gr.nsf
; 候選檢視（分號分隔）：啟動時用前幾個 key 驗證，第一個「查得到且 DCNUM 相符」的採用；都不行退回公式搜尋
gr_view      = (ByDocNo);(AllByDocNoOnly);(DocNo);(AllByGRNo);(AllByGRNoV2)
gr_key_field = DCNUM
; 想順便抓 GR 文件欄位就填，逗號分隔；留空＝只要連結
gr_fetch_fields =

; 輸入 Excel：留空＝執行時用命令列給（MatchPmsDocs.exe 檔案.xlsx），也可直接把檔案拖到 exe 上
input_xlsx   =
sheet        =
key_column   = name
amt_column   = amt
header_row   = 1

; 輸出：留空＝<輸入檔名>_notes.xlsx 放同資料夾
output_xlsx  =
sheet_per_category = true
log_file     = match_pms_docs_log.txt
